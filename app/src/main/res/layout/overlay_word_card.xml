<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/overlay_scrim"
    android:padding="20dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:strokeColor="@color/gold"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Header: Word Number, Frequency badge, Close button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvOverlayWordNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Word 1 / 500" />

                <TextView
                    android:id="@+id/tvOverlayFrequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/tvOverlayWordNumber"
                    android:background="@color/gold_light"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textColor="@color/gold_dark"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="3,226 times" />

                <ImageButton
                    android:id="@+id/btnOverlayClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/text_muted" />
            </RelativeLayout>

            <!-- Arabic Word (Large, Prominent, Center) -->
            <TextView
                android:id="@+id/tvOverlayArabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/primary_dark"
                android:textSize="44sp"
                android:textStyle="bold"
                tools:text="مِنْ" />

            <!-- Transliteration & Grammar Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOverlayTransliteration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="17sp"
                    android:textStyle="bold|italic"
                    tools:text="min" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:text="•"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/tvOverlayGrammar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gold_dark"
                    android:textSize="13sp"
                    tools:text="Preposition" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="#E2E8F0" />

            <!-- Urdu Meaning -->
            <TextView
                android:id="@+id/tvOverlayUrdu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="سے ، میں سے" />

            <!-- English Meaning -->
            <TextView
                android:id="@+id/tvOverlayEnglish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                tools:text="from, out of" />

            <!-- Quranic Reference Box -->
            <TextView
                android:id="@+id/tvOverlayReference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#F1F5F9"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="italic"
                tools:text="Quran Reference: 113:2" />

            <!-- Action Buttons: Star/Memorized and Next -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlayMemorize"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/mark_memorized"
                    android:textSize="12sp"
                    app:strokeColor="@color/gold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlayNext"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary"
                    android:text="@string/next_word"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
